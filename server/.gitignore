# ##############################################################################
# Dependencies
# ##############################################################################
# Never commit the massive node_modules folder. It should be installed fresh via npm/yarn.
node_modules/
jspm_packages/
web_modules/

# ##############################################################################
# Logs
# ##############################################################################
# Exclude debug, error, and system logs generated by npm, yarn, and pnpm.
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ##############################################################################
# Environment & Secrets (CRITICAL)
# ##############################################################################
# Absolute protection for application secrets, API keys, and local configurations.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.bak

# ##############################################################################
# Build Outputs & Caches
# ##############################################################################
# Exclude compiled files, bundles, and build tooling artifacts.
dist/
build/
.node_repl_history
.npm
.eslintcache
.stylelintcache
.prettiercache
.parcel-cache
.turbo
.next
.nuxt
out/

# ##############################################################################
# Testing & Coverage
# ##############################################################################
# Exclude coverage reports generated by Jest, Istanbul, or NYC.
coverage/
.nyc_output/

# ##############################################################################
# Diagnostic & System Files
# ##############################################################################
# Process IDs and runtime dumps.
pids
*.pid
*.seed
*.pid.lock

# Operating System specific files
.DS_Store
Thumbs.db
